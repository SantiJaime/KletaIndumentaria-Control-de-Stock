# Copiar a .env y completar con los datos de Supabase (Project Settings > Database > Connection string).
# Si la contraseña tiene caracteres especiales (@ # & ^ / : ? %), van codificados: @ -> %40, # -> %23, etc.

# Pooler en modo transacción (puerto 6543): lo usa la app en runtime.
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres"

# Pooler en modo sesión (puerto 5432): lo usa Prisma CLI para las migraciones.
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Orígenes permitidos para CORS (separados por coma). Por defecto http://localhost:5173 (Vite).
# CORS_ORIGIN="http://localhost:5173"

# Secretos para firmar los tokens JWT. Tienen que ser distintos entre sí y largos (ej. `openssl rand -hex 48`).
JWT_ACCESS_SECRET="cambiar-por-un-secreto-largo"
JWT_REFRESH_SECRET="cambiar-por-otro-secreto-largo"

# Cookies de sesión. `secure` va solo con HTTPS (por defecto: activo si NODE_ENV=production).
# Si el front y la API están en dominios distintos (VITE_API_URL), usar COOKIE_SAMESITE="none" (requiere secure).
# COOKIE_SECURE="true"
# COOKIE_SAMESITE="lax"
